PORT=3000
# آدرس عمومی همین سرویس
PUBLIC_URL=http://localhost:3000
# korsi-pay روی دامنه‌ی ثبت‌شده‌ی مرچنت؛ خالی = اتصال مستقیم به زرین‌پال
PAY_PROXY_URL=https://checkout.vpsbaz.ir
# خالی = درگاه آزمایشی داخلی
ZARINPAL_MERCHANT=
ZARINPAL_SANDBOX=0

ADMIN_USER=admin
ADMIN_PASS=
# کلید امضای نشست‌ها (یه رشته‌ی تصادفی بلند)
SECRET=

# ربات تلگرام: توکن از BotFather و آیدی عددی صاحب ربات
TG_BOT_TOKEN=
TG_ADMIN_ID=
# اگه سرور به api.telegram.org دسترسی نداره، آدرس یه reverse proxy
TG_API=https://api.telegram.org

DB_PATH=./data/my-pay.db
OWNER_NAME=حمید سارانی
